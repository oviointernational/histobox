/**
 * allEntities.ts — Generic Supabase CRUD helpers + per-entity row mappers.
 *
 * Each entity section exposes:
 *   fetchX()   → select * from table
 *   upsertX()  → insert or update (conflict on id)
 *   deleteX()  → delete by id
 *
 * Live schemas were confirmed via REST probe; supabase-setup.sql may differ.
 */
import { supabase } from '@/integrations/supabase/client';
import type {
  Report, Equipment, MaintenanceLog, SpecialRequest, QueryCase,
  AppSettings, SystemRole,
} from '@/types';
import type { Reagent, ReagentConsumable, ReagentManual } from '@/types/reagent';
import type { ImmunoReagent, ImmunoRun } from '@/types/immuno';
import type { LabSupply } from '@/types/labsupply';
import type { Exam, ExamSubmission, ExamBankQuestion } from '@/types/exam';
import type { RosterEntry } from '@/types/roster';
import type { MiscTab, MiscLabel, MiscItem } from '@/types/misc';
import type { Attendance, AttendanceAttendee } from '@/types/attendance';

const sb = supabase as any;

// ─── Generic helpers ─────────────────────────────────────────────────────────

async function fetchTable<T>(table: string, fromRow: (r: any) => T, order = 'created_at'): Promise<T[]> {
  // Supabase/PostgREST commonly limits a response to 1,000 rows. Page until a
  // short response is returned so older records never silently disappear.
  const pageSize = 1000;
  const rows: any[] = [];
  for (let from = 0; ; from += pageSize) {
    const { data, error } = await sb
      .from(table)
      .select('*')
      .order(order, { ascending: false })
      .range(from, from + pageSize - 1);
    if (error) throw error;
    const page = data ?? [];
    rows.push(...page);
    if (page.length < pageSize) break;
  }
  return rows.map(fromRow);
}

async function upsertRow(table: string, row: any): Promise<void> {
  const { error } = await sb.from(table).upsert(row);
  if (error) throw error;
}

async function deleteRow(table: string, id: string): Promise<void> {
  const { error } = await sb.from(table).delete().eq('id', id);
  if (error) throw error;
}

function tsDate(v: any): Date {
  return v ? new Date(v) : new Date();
}

// ─── reports ─────────────────────────────────────────────────────────────────
// Live cols: id, serial_number, title, category, type, reported_by, mls_in_charge,
//            superior_reported, location, description, immediate_action,
//            root_cause_analysis, corrective_actions, logs, created_at, updated_at

function reportFromRow(r: any): Report {
  return {
    id: r.id,
    serialNumber: r.serial_number ?? 0,
    title: r.title ?? '',
    category: r.category ?? 'Incident',
    type: r.type ?? '',
    reportedBy: r.reported_by ?? '',
    mlsInCharge: r.mls_in_charge ?? '',
    superiorReported: r.superior_reported ?? '',
    location: r.location ?? '',
    description: r.description ?? '',
    immediateAction: r.immediate_action ?? '',
    rootCauseAnalysis: r.root_cause_analysis ?? '',
    correctiveActions: r.corrective_actions ?? '',
    createdAt: tsDate(r.created_at),
    updatedAt: tsDate(r.updated_at),
    logs: (r.logs ?? []).map((l: any) => ({ ...l, timestamp: tsDate(l.timestamp) })),
  };
}

function reportToRow(r: Report) {
  return {
    id: r.id,
    serial_number: r.serialNumber,
    title: r.title,
    category: r.category,
    type: r.type,
    reported_by: r.reportedBy,
    mls_in_charge: r.mlsInCharge,
    superior_reported: r.superiorReported,
    location: r.location,
    description: r.description,
    immediate_action: r.immediateAction,
    root_cause_analysis: r.rootCauseAnalysis,
    corrective_actions: r.correctiveActions,
    logs: r.logs,
    updated_at: new Date().toISOString(),
  };
}

export const fetchReports = () => fetchTable<Report>('reports', reportFromRow);
export const upsertReport = (r: Report) => upsertRow('reports', reportToRow(r));
export const deleteReport = (id: string) => deleteRow('reports', id);

// ─── equipment / maintenance ──────────────────────────────────────────────────
// Live cols: id, name, image_url, commissioned, template_id, maintenance_logs,
//            created_at, updated_at

function equipmentFromRow(r: any): Equipment {
  return {
    id: r.id,
    name: r.name ?? '',
    imageUrl: r.image_url ?? undefined,
    commissioned: r.commissioned ?? true,
    templateId: r.template_id ?? '',
    maintenanceLogs: (r.maintenance_logs ?? []).map((l: any) => ({
      ...l,
      date: tsDate(l.date),
    })) as MaintenanceLog[],
    createdAt: tsDate(r.created_at),
    updatedAt: tsDate(r.updated_at),
  };
}

function equipmentToRow(e: Equipment) {
  return {
    id: e.id,
    name: e.name,
    image_url: e.imageUrl ?? '',
    commissioned: e.commissioned,
    template_id: e.templateId,
    maintenance_logs: e.maintenanceLogs,
    updated_at: new Date().toISOString(),
  };
}

export const fetchEquipment = () => fetchTable<Equipment>('equipment', equipmentFromRow);
export const upsertEquipment = (e: Equipment) => upsertRow('equipment', equipmentToRow(e));
export const deleteEquipment = (id: string) => deleteRow('equipment', id);

